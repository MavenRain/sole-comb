-- Dependent pairs retain runtime fields and evaluate projection scrutinees once.
axiom Nat : Type 0
axiom P : Prop
axiom proof : P
def Both : Type 0 := (x : Nat) * Nat
def both : Both := (11, 6)
def first : Nat := elim both { fun (x : Nat) (y : Nat) => x }
def second : Nat := elim both { fun (x : Nat) (y : Nat) => y }
def make : Nat -> Both := fun (n : Nat) => (n, natAdd n 1)
def returned : Nat := elim (make 4) { fun (x : Nat) (y : Nat) => y }
def PointOnly : Type 0 := Nat * P
def pointOnly : PointOnly := (3, proof)
def pointValue : Nat := elim pointOnly { fun (x : Nat) (y : P) => x }
def droppedProof : P := elim pointOnly { fun (x : Nat) (y : P) => y }
def FibreOnly : Type 0 := (0 x : Nat) * Nat
def fibreOnly : FibreOnly := (10, 20)
def fibreValue : Nat := elim fibreOnly { fun (0 x : Nat) (y : Nat) => y }
def Neither : Type 1 := Type 0 * P
def neither : Neither := (Nat, proof)
def droppedType : Type 0 := elim neither { fun (x : Type 0) (y : P) => x }
def Dependent : Type 1 := (0 A : Type 0) * A
def dependent : Dependent := (Nat, 7)
def box : (0 A : Type 0) -> (x : A) -> (0 T : Type 0) * T := fun (0 A : Type 0) (x : A) => (A, x)
def unbox : (0 A : Type 0) -> ((0 T : Type 0) * T) -> Nat := fun (0 A : Type 0) (p : (0 T : Type 0) * T) => 9
def Nested : Type 0 := Nat * Both
def nested : Nested := (8, both)
def nestedValue : Nat := elim (elim nested as value return Both { fun (x : Nat) (y : Both) => y }) { fun (x : Nat) (y : Nat) => x }
def FunctionPair : Type 0 := Nat * (Nat -> Nat)
def capture : Nat -> FunctionPair := fun (outer : Nat) => (outer, fun (n : Nat) => natAdd outer n)
def applyPair : FunctionPair -> Nat := fun (p : FunctionPair) => (elim p as value return Nat -> Nat { fun (x : Nat) (y : Nat -> Nat) => y }) 5
def outerAfter : Nat -> Both -> Nat := fun (outer : Nat) (p : Both) => natAdd outer (elim p { fun (x : Nat) (y : Nat) => y })
def capturedAfter : Nat -> Both -> (Nat -> Nat) := fun (outer : Nat) (p : Both) => let value : Nat := elim p { fun (x : Nat) (y : Nat) => y } in fun (n : Nat) => natAdd outer (natAdd value n)
def poly : (0 A : Type 0) -> (x : A) -> (a : A) * A := fun (0 A : Type 0) (x : A) => (x, x)
def polyValue : Nat := elim (poly Nat 5) { fun (x : Nat) (y : Nat) => x }
