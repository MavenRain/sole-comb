axiom Nat : Type 1
def Pair : Type 1 := (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat]))
def Pair.first : (Ran SPi 1 #record Pair Nat) := (Sec SPi 1 #record Pair [#record => (Out SColl 2 (ALeg 0) #record)])
def Pair.second : (Ran SPi 1 #record Pair Nat) := (Sec SPi 1 #record Pair [#record => (Out SColl 2 (ALeg 1) #record)])
def pair : Pair := (Sec SColl 2 [ => 10;  => 20])
def first : Nat := (Out SPi 1 #record (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt 1 pair) Pair.first)
def second : Nat := (Out SPi 1 #record (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt 1 pair) Pair.second)
def linearFirst : (Ran SPi 1 p Pair Nat) := (Sec SPi 1 p Pair [p => (Out SPi 1 #record (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt 1 p) Pair.first)])
def Empty : Type 1 := (Ran SColl 0 (Sec SColl 0 []))
def empty : Empty := (Sec SColl 0 [])
def Other : Type 1 := (Ran SColl 1 (Sec SColl 1 [ => Nat]))
def Other.first : (Ran SPi 1 #record Other Nat) := (Sec SPi 1 #record Other [#record => (Out SColl 1 (ALeg 0) #record)])
def other : Other := (Sec SColl 1 [ => 30])
def otherFirst : Nat := (Out SPi 1 #record (Ran SColl 1 (Sec SColl 1 [ => Nat])) (APt 1 other) Other.first)
def Packet : Type 2 := (Ran SColl 4 (Sec SColl 4 [ => Type 1;  => Pair;  => (Ran SPi w _ Nat Nat);  => Nat]))
def Packet.kind : (Ran SPi 1 #record Packet Type 1) := (Sec SPi 1 #record Packet [#record => (Out SColl 4 (ALeg 0) #record)])
def Packet.payload : (Ran SPi 1 #record Packet Pair) := (Sec SPi 1 #record Packet [#record => (Out SColl 4 (ALeg 1) #record)])
def Packet.handler : (Ran SPi 1 #record Packet (Ran SPi w _ Nat Nat)) := (Sec SPi 1 #record Packet [#record => (Out SColl 4 (ALeg 2) #record)])
def Packet.count : (Ran SPi 1 #record Packet Nat) := (Sec SPi 1 #record Packet [#record => (Out SColl 4 (ALeg 3) #record)])
def packet : Packet := (Sec SColl 4 [ => Nat;  => pair;  => (Sec SPi w n Nat [n => (Out SPi w b Nat (APt w 1) (Out SPi w a Nat (APt w n) natAdd))]);  => 40])
def payload : Pair := (Out SPi 1 #record (Ran SColl 4 (Sec SColl 4 [ => Type 1;  => (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat]));  => (Ran SPi w _ Nat Nat);  => Nat])) (APt 1 packet) Packet.payload)
def handled : Nat := (Out SPi w _ Nat (APt w (Out SPi 1 #record (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat])) (APt 1 payload) Pair.first)) (Out SPi 1 #record (Ran SColl 4 (Sec SColl 4 [ => Type 1;  => (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat]));  => (Ran SPi w _ Nat Nat);  => Nat])) (APt 1 packet) Packet.handler))
def count : Nat := (Out SPi 1 #record (Ran SColl 4 (Sec SColl 4 [ => Type 1;  => (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat]));  => (Ran SPi w _ Nat Nat);  => Nat])) (APt 1 packet) Packet.count)
def kind : Type 1 := (Out SPi 1 #record (Ran SColl 4 (Sec SColl 4 [ => Type 1;  => (Ran SColl 2 (Sec SColl 2 [ => Nat;  => Nat]));  => (Ran SPi w _ Nat Nat);  => Nat])) (APt 1 packet) Packet.kind)
def value : Type 1 := Nat
def Capture : Type 1 := (Ran SColl 1 (Sec SColl 1 [ => value]))
def Capture.item : (Ran SPi 1 #record Capture value) := (Sec SPi 1 #record Capture [#record => (Out SColl 1 (ALeg 0) #record)])
def capture : Capture := (Sec SColl 1 [ => 50])
def captured : value := (Out SPi 1 #record (Ran SColl 1 (Sec SColl 1 [ => Nat])) (APt 1 capture) Capture.item)
def picked : Nat := (Elim SColl 2 ((In SColl 2 (ALeg 1) [other]) : (Lan SColl 2 (Sec SColl 2 [ => Other;  => Other]))) with | (ALeg 0) $elim => (Out SPi 1 #record (Ran SColl 1 (Sec SColl 1 [ => Nat])) (APt 1 $elim) Other.first) | (ALeg 1) $elim => (Out SPi 1 #record (Ran SColl 1 (Sec SColl 1 [ => Nat])) (APt 1 $elim) Other.first))
axiom Other.zero : Other
def zeroFirst : Nat := (Out SPi 1 #record (Ran SColl 1 (Sec SColl 1 [ => Nat])) (APt 1 Other.zero) Other.first)
