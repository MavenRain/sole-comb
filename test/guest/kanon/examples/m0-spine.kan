-- examples/m0-spine.kan:  the M0 spine.
--
-- main is 521.
--
-- The spine holds every row of the emission table of SPEC.md section
-- 8.1 and every production of the surface grammar of SPEC.md section 9
-- that M0 accepts.  It postulates nothing, so the AXIOMS leg of the
-- gate battery reads no name out of it and the leg prints nothing.
-- Section 9 also names auto, mu and nu.  The checker refuses auto and
-- the parser refuses mu and nu, because instances and the recursive
-- shapes arrive at a later milestone, so the spine omits those three
-- words (SE-D22).
--
-- One line per definition, in file order:  the row of section 8.1 that
-- the definition witnesses, then the production of section 9.
--
-- Unit:  no row, a type erases;  prod with no component.
-- Empty:  no row;  sum with no leg, at Prop.
-- Bool:  no row;  sum of two legs, and the annotation ( t : T ).
-- Pair:  no row;  binder '*' term.
-- NatPair:  no row;  term '*' term.
-- Triple:  no row;  prod of three components.
-- Four:  no row;  sum of four legs.
-- Two:  no row;  sum of two legs.
-- propAtZero:  no row;  Prop.
-- typeZeroAtOne:  no row;  Type 1 and Type 0.
-- bareType:  no row;  Type with no level.
-- propArrow:  no row;  the binder mark 0 over Prop.
-- u:  a pair or a tuple with no field;  ( ).
-- uTuple:  a pair or a tuple with no field;  tuple with no component.
-- toNat:  a case;  case .. with, and a branch binder.
-- sumTwo:  a primitive and a literal;  natAdd and nat.
-- diff:  a primitive;  natSub.
-- truncated:  a primitive;  natSub, which stops at zero.
-- scaled:  a primitive;  natMul over two names.
-- eqFlag:  a primitive;  natEq at the true leg.
-- neFlag:  a primitive;  natEq at the false leg.
-- ltFlag:  a primitive;  natLt at the true leg.
-- geFlag:  a primitive;  natLt at the false leg.
-- prims:  a call of a known function;  application.
-- step:  a call of a known function;  fun with two binders.
-- chain:  a call of a known function in tail position;  application.
-- outer:  a call of a known function in tail position;  application.
-- tailChain:  a call of a known function;  application.
-- p:  a pair or a tuple;  ( t , t ).
-- mkPair:  a pair or a tuple;  binder '->' term.
-- q:  a call of a known function;  application.
-- pairs:  a projection;  t.1 and t.2.
-- t:  a pair or a tuple;  tuple of three components.
-- tuples:  a projection;  t.0, t.1 and t.2 at a tuple.
-- z0:  a tag with no payload;  inj 0 of 4.
-- z1:  a tag with no payload;  inj 1 of 4.
-- p2:  a tag with a payload;  inj 2 of 4.
-- p3:  a tag with a payload;  inj 3 of 4.
-- readFour:  a case;  four branches over four legs.
-- sums:  a call of a known function;  application.
-- readMotive:  a case;  case .. as x return T with.
-- motives:  a call of a known function;  application.
-- mk:  a closure;  fun inside a pair, with a parameter capture.
-- mkLet:  a closure;  fun inside a pair, with a let bound capture.
-- closures:  a call of a closure;  application of a projection.
-- add3:  a call of a known function;  fun with two binders.
-- apply2:  an application of an unknown arity;  a function binder.
-- half:  a partial application;  add3 under its arity.
-- alias:  a partial application;  natAdd under its arity.
-- applications:  a partial application and an over application;  application.
-- viaParam:  an application of an unknown arity;  a function binder.
-- viaParamValue:  a call of a known function;  application.
-- id:  an erased argument;  the binder mark 0.
-- idNat:  a partial application;  id under its arity.
-- erasedPoly:  an erased argument;  application at Nat.
-- linear:  a call of a known function;  the binder mark 1.
-- linearValue:  a call of a known function;  application.
-- pick:  a let and a case;  let .. in with a case inside it.
-- lets:  a let;  application.
-- annotated:  a literal;  ( t : T ).
-- letOfAnn:  a let;  let .. in over ( t : T ).
-- annotations:  a call of a known function;  application.
-- fromEmpty:  the empty case, which emits unreachable;  absurd.
-- box:  a pair or a tuple;  an erased binder and a pair.
-- first:  a projection;  p.1 at an erased type.
-- pack:  a pair or a tuple;  tuple at an erased type.
-- choose:  a tag with a payload;  inj at an erased type.
-- unchoose:  a case;  a case at an erased type.
-- sumNat:  a case;  a case over the answer of a call.
-- nested:  a projection;  two projections in a row.
-- inc:  a closure;  fun with one binder.
-- fromClosure:  a call of a closure;  application of a projection.
-- generics:  a call of a known function;  application.
-- readBool:  a case;  a case over a call of a function binder.
-- eqOne:  a closure;  fun with one binder.
-- functionCase:  a call of a known function;  application.
-- polyPair:  a projection;  a projection at an erased type.
-- polyCase:  a case;  a case over an erased identity.
-- groupA:  a call of a known function;  application.
-- groupB:  a call of a known function;  application.
-- groupC:  a call of a known function;  application.
-- groupD:  a call of a known function;  application.
-- main:  the export;  def with no binder.

-- The types.  A type is erased, so none of these reaches a row of the
-- emission table on its own.

def Unit : Type 0 := prod ()
def Empty : Prop := sum ()
def Bool : Type 0 := sum ((prod () : Type 0), (prod () : Type 0))
def Pair : Type 0 := (a : Nat) * Nat
def NatPair : Type 0 := Nat * Nat
def Triple : Type 0 := prod (Nat, Nat, Nat)
def Four : Type 0 := sum ((prod () : Type 0), (prod () : Type 0), Nat, Nat)
def Two : Type 0 := sum (Nat, Nat)

-- The universes.

def propAtZero : Type 0 := Prop
def typeZeroAtOne : Type 1 := Type 0
def bareType : Type 1 := Type
def propArrow : Type 0 := (0 P : Prop) -> Prop

-- The empty collection at both formers.

def u : Unit := ()
def uTuple : Unit := tuple ()

-- The five prims.  natSub stops at zero, and natEq and natLt answer the
-- two leg sum that toNat reads back into a Nat.

def toNat : (b : Bool) -> Nat :=
  fun (b : Bool) =>
    case b with
    | 0 (x : prod ()) => 0
    | 1 (y : prod ()) => 1

def sumTwo : Nat := natAdd 2 3
def diff : Nat := natSub 7 4
def truncated : Nat := natSub 3 9
def scaled : Nat := natMul sumTwo diff
def eqFlag : Nat := toNat (natEq 4 4)
def neFlag : Nat := toNat (natEq 4 5)
def ltFlag : Nat := toNat (natLt 1 2)
def geFlag : Nat := toNat (natLt 5 2)

def prims : Nat :=
  natAdd (natAdd scaled truncated)
    (natAdd (natAdd eqFlag ltFlag) (natAdd neFlag geFlag))

-- A chain of tail calls through a helper of arity two.

def step : (a : Nat) -> (b : Nat) -> Nat :=
  fun (a : Nat) (b : Nat) => natAdd a b

def chain : (a : Nat) -> (b : Nat) -> Nat :=
  fun (a : Nat) (b : Nat) => step (natAdd a 1) b

def outer : (a : Nat) -> (b : Nat) -> Nat :=
  fun (a : Nat) (b : Nat) => chain (natAdd a 2) b

def tailChain : Nat := outer 3 4

-- A pair built and projected on both sides, once from a definition and
-- once from the answer of a function.

def p : Pair := (11, 6)

def mkPair : (x : Nat) -> (a : Nat) * Nat :=
  fun (x : Nat) => (x, natAdd x 1)

def q : Pair := mkPair 4

def pairs : Nat := natAdd (natAdd p.1 p.2) (natAdd q.1 q.2)

-- A three leg tuple built and projected.

def t : Triple := tuple (2, 3, 4)

def tuples : Nat := natAdd (natMul t.0 t.1) t.2

-- A sum with two payload free legs and two payload legs, cased on every
-- leg, and a second case that writes the motive.

def z0 : Four := inj 0 of 4 (tuple ())
def z1 : Four := inj 1 of 4 (tuple ())
def p2 : Four := inj 2 of 4 5
def p3 : Four := inj 3 of 4 6

def readFour : (x : Four) -> Nat :=
  fun (x : Four) =>
    case x with
    | 0 (a : prod ()) => 1
    | 1 (b : prod ()) => 2
    | 2 (c : Nat) => natAdd c 10
    | 3 (d : Nat) => natMul d 10

def sums : Nat :=
  natAdd (natAdd (readFour z0) (readFour z1)) (natAdd (readFour p2) (readFour p3))

def readMotive : (x : Two) -> Nat :=
  fun (x : Two) =>
    case x as y return Nat with
    | 0 (a : Nat) => a
    | 1 (b : Nat) => natAdd b 1

def motives : Nat := natAdd (readMotive (inj 0 of 2 3)) (readMotive (inj 1 of 2 4))

-- A closure with a parameter capture and a closure with a let bound
-- capture, each stored in a pair and applied later.

def mk : (x : Nat) -> (f : Nat -> Nat) * Nat :=
  fun (x : Nat) => ((fun (y : Nat) => natAdd x y), natMul x 2)

def mkLet : (x : Nat) -> (f : Nat -> Nat) * Nat :=
  fun (x : Nat) =>
    let z : Nat := natAdd x 1 in
    ((fun (y : Nat) => natAdd z y), z)

def closures : Nat :=
  natAdd (natAdd ((mk 5).1 6) (mk 5).2) (natAdd ((mkLet 2).1 4) (mkLet 2).2)

-- A partial application under the arity, an application over the arity
-- and a call through a function parameter of an unknown arity.

def add3 : (a : Nat) -> (b : Nat) -> Nat :=
  fun (a : Nat) (b : Nat) => natAdd (natAdd a b) 3

def apply2 : (f : Nat -> Nat -> Nat) -> (x : Nat) -> Nat -> Nat :=
  fun (f : Nat -> Nat -> Nat) (x : Nat) => f x

def half : Nat -> Nat := add3 4
def alias : Nat -> Nat := natAdd 1

def applications : Nat := natAdd (natAdd (half 5) (alias 2)) (apply2 natAdd 4 6)

def viaParam : (f : Nat -> Nat) -> (x : Nat) -> Nat :=
  fun (f : Nat -> Nat) (x : Nat) => f x

def viaParamValue : Nat := viaParam half 6

-- The erased polymorphic identity, used at Nat, and the linear binder.

def id : (0 A : Type 0) -> (x : A) -> A :=
  fun (0 A : Type 0) (x : A) => x

def idNat : (x : Nat) -> Nat := id Nat

def erasedPoly : Nat := natAdd (id Nat 3) (idNat 4)

def linear : (1 x : Nat) -> Nat :=
  fun (1 x : Nat) => x

-- Stage K: natAdd consumes unrestricted arguments; the identity uses x once.
def linearValue : Nat := natAdd (linear 8) 1

-- A nested let with a case inside it, and the annotation form.

def pick : (s : Two) -> Nat :=
  fun (s : Two) =>
    let base : Nat := 10 in
    let bump : Nat := (case s with | 0 (a : Nat) => natAdd a 1 | 1 (b : Nat) => natMul b 2) in
    let total : Nat := natAdd base bump in
    natAdd total 100

def lets : Nat := natAdd (pick (inj 0 of 2 3)) (pick (inj 1 of 2 4))

def annotated : Nat := (5 : Nat)
def letOfAnn : Nat := let x : Nat := (7 : Nat) in x

def annotations : Nat := natAdd annotated letOfAnn

-- A function over the empty sum.  main never calls it, so the emitter
-- writes the unreachable row without a trap at run time.

def fromEmpty : (x : sum ()) -> Nat := fun (x : sum ()) => absurd x

-- Aggregates under an erased type parameter, in both directions.

def box : (0 A : Type 0) -> (x : A) -> (a : A) * A :=
  fun (0 A : Type 0) (x : A) => (x, x)

def first : (0 A : Type 0) -> (r : (a : A) * A) -> A :=
  fun (0 A : Type 0) (r : (a : A) * A) => r.1

def pack : (0 A : Type 0) -> (x : A) -> prod (A, A) :=
  fun (0 A : Type 0) (x : A) => tuple (x, x)

def choose : (0 A : Type 0) -> (x : A) -> sum (A, A) :=
  fun (0 A : Type 0) (x : A) => inj 1 of 2 x

def unchoose : (0 A : Type 0) -> (s : sum (A, A)) -> A :=
  fun (0 A : Type 0) (s : sum (A, A)) =>
    case s with
    | 0 (a : A) => a
    | 1 (b : A) => b

def sumNat : Nat :=
  case (id (sum (Nat, Nat)) (choose Nat 7)) with
  | 0 (a : Nat) => a
  | 1 (b : Nat) => natAdd b 1

def nested : Nat := (box ((a : Nat) * Nat) (box Nat 5)).1.2

def inc : Nat -> Nat := fun (x : Nat) => natAdd x 1

def fromClosure : Nat := (pack (Nat -> Nat) inc).0 8

def generics : Nat :=
  natAdd (natAdd (first Nat (3, 4)) (pack Nat 9).1)
    (natAdd (unchoose Nat (inj 0 of 2 2)) (natAdd sumNat (natAdd nested fromClosure)))

-- A case over the answer of a call through a function parameter, and a
-- case that keeps its sum after the erased identity answers any.

def readBool : (f : Nat -> Bool) -> Nat :=
  fun (f : Nat -> Bool) =>
    case (f 1) with
    | 0 (a : prod ()) => 0
    | 1 (b : prod ()) => 1

def eqOne : Nat -> Bool := fun (x : Nat) => natEq x 1

def functionCase : Nat := readBool eqOne

def polyPair : Nat := (box Nat 5).1

def polyCase : Nat :=
  case (id Bool (natEq 1 1)) with
  | 0 (a : prod ()) => 0
  | 1 (b : prod ()) => 1

-- The export.  Every group above reaches this value.
--
--   groupA  17 + 10 + 26 + 10   =  63
--   groupB  78 +  8 + 31 + 25   = 142
--   groupC  13 +  7 +  9 + 232  = 261
--   groupD  12 + 36 +  1 + 5 + 1 =  55
--
-- and 63 + 142 + 261 + 55 = 521.

def groupA : Nat := natAdd (natAdd prims tailChain) (natAdd pairs tuples)

def groupB : Nat := natAdd (natAdd sums motives) (natAdd closures applications)

def groupC : Nat :=
  natAdd (natAdd viaParamValue erasedPoly) (natAdd linearValue lets)

def groupD : Nat :=
  natAdd (natAdd annotations generics)
    (natAdd functionCase (natAdd polyPair polyCase))

def main : Nat := natAdd (natAdd groupA groupB) (natAdd groupC groupD)
