axiom P : Prop
axiom proof : P

mu N : Type 0 with
| zero : N
| succ : N -> N

def first : N := zero
def second : N := succ zero
def reverse : N -> Nat := fun (n : N) => case n as x in N return Nat with | succ m => 2 | zero => 1
def nested : N -> N := fun (n : N) => case n as x in N return N with | zero => succ zero | succ m => m

mu Ghost : Type 0 with
| ghost : (0 erased : Nat) -> P -> Nat -> Ghost
def ghostValue : Ghost := ghost 99 proof 7
def ghostRead : Ghost -> Nat := fun (g : Ghost) => case g as x in Ghost return Nat with | ghost 0 gone witness value => value
def afterGhost : Nat -> Ghost -> Nat := fun (outer : Nat) (g : Ghost) => case g as x in Ghost return Nat with | ghost 0 gone witness value => natAdd outer value
def capture : Nat -> Ghost -> (Nat -> Nat) := fun (outer : Nat) (g : Ghost) => case g as x in Ghost return Nat -> Nat with | ghost 0 gone witness value => fun (n : Nat) => natAdd outer (natAdd value n)

mu Box (0 A : Type 0) : Type 0 with
| box : A -> Box A
def boxRead : Box (prod ()) -> Nat := fun (b : Box (prod ())) => case b as x in Box return Nat with | box p => 5
def boxCapture : Nat -> Box (prod ()) -> (Nat -> Nat) := fun (outer : Nat) (b : Box (prod ())) => case b as x in Box return Nat -> Nat with | box p => fun (n : Nat) => natAdd outer n

mu V : (0 i : N) -> Type 0 with
| vz : V zero
| vs : (0 i : N) -> Nat -> V i -> V (succ i)
def vector : V (succ zero) := vs zero 11 vz
def head : (0 i : N) -> V i -> Nat := fun (0 i : N) (v : V i) => case v as x in V j return Nat with | vs 0 k a w => a | vz => 0
def copy : (0 i : N) -> V i -> V i := fun (0 i : N) (v : V i) => case v as x in V j return V j with | vz => vz | vs 0 k a w => vs k a w

mu Left : Type 0 with
| leaf : Left
| node : Right -> Left
and Right : Type 0 with
| link : Left -> Right
def mutualValue : Left := node (link leaf)
def leftRead : Left -> Nat := fun (a : Left) => case a as x in Left return Nat with | node b => 2 | leaf => 1
def rightRead : Right -> Left := fun (b : Right) => case b as x in Right return Left with | link a => a

mu Empty : Type 0 with
axiom empty : Empty
def emptyRead : Nat := case empty as x in Empty return Nat with
