exit 0
--- stdout
def three : (Lan SMu N [] (Sec SColl 0 [])) := (In SMu N [] (ACtor succ) [(In SMu N [] (ACtor succ) [(In SMu N [] (ACtor succ) [(In SMu N [] (ACtor zero) [])])])])
def double : (Ran SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (Lan SMu N [] (Sec SColl 0 []))) := (Sec SPi w n (Lan SMu N [] (Sec SColl 0 [])) [n => (Elim SMu N [] n as x return (Lan SMu N [] (Sec SColl 0 [])) with | (ACtor zero)  => (In SMu N [] (ACtor zero) []) | (ACtor succ) m => (In SMu N [] (ACtor succ) [(In SMu N [] (ACtor succ) [(Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w m) double)])]))])
def count : (Ran SPi w _ (Lan SMu N [] (Sec SColl 0 [])) Nat) := (Sec SPi w n (Lan SMu N [] (Sec SColl 0 [])) [n => (Elim SMu N [] n as x return Nat with | (ACtor zero)  => 0 | (ACtor succ) m => (Out SPi w b Nat (APt w (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w m) count)) (Out SPi w a Nat (APt w 1) natAdd)))])
def main : Nat := (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w three) double)) count)
--- stderr
