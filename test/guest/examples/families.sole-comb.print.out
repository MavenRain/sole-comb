def rightRead : (Ran SPi w _ (Lan SMu Right [] (Sec SColl 0 [])) (Lan SMu Left [] (Sec SColl 0 []))) := (Sec SPi w b (Lan SMu Right [] (Sec SColl 0 [])) [b => (Elim SMu Right [] b as x return (Lan SMu Left [] (Sec SColl 0 [])) with | (ACtor link) a => a)])
def boxRead : (Ran SPi w _ (Lan SMu Box [] (Sec SColl 1 [ => (Ran SColl 0 (Sec SColl 0 []))])) Nat) := (Sec SPi w b (Lan SMu Box [] (Sec SColl 1 [ => (Ran SColl 0 (Sec SColl 0 []))])) [b => (Elim SMu Box [] b as x return Nat with | (ACtor box) p => 5)])
