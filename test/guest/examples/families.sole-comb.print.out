def capture : (Ran SPi w _ Nat (Ran SPi w _ (Lan SMu Ghost [] (Sec SColl 0 [])) (Ran SPi w _ Nat Nat))) := (Sec SPi w outer Nat [outer => (Sec SPi w g (Lan SMu Ghost [] (Sec SColl 0 [])) [g => (Elim SMu Ghost [] g as x return (Ran SPi w _ Nat Nat) with | (ACtor ghost) gone witness value => (Sec SPi w n Nat [n => (Out SPi w b Nat (APt w (Out SPi w b Nat (APt w n) (Out SPi w a Nat (APt w value) natAdd))) (Out SPi w a Nat (APt w outer) natAdd))]))])])
