def answer : Nat := (Out SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (APt w second) read)
def nullFunction : (Ran SPi w _ (Lan SMu N [] (Sec SColl 0 [])) (Ran SPi w _ Nat Nat)) := (Sec SPi w n (Lan SMu N [] (Sec SColl 0 [])) [n => (Elim SMu N [] n as z return (Ran SPi w _ Nat Nat) with | (ACtor zero)  => (Sec SPi w x Nat [x => x]) | (ACtor succ) m => (Sec SPi w x Nat [x => (Out SPi w b Nat (APt w 1) (Out SPi w a Nat (APt w x) natAdd))]))])
