-- Family parameters are inferred from the expected result or argument type.
mu Box (0 A : Type 0) : Type 0 { box : A -> Box A }
def value : Box Nat := box 7
def nested : Box (Box Nat) := box (box 8)
def make : (0 A : Type 0) -> A -> Box A := fun (0 A : Type 0) (a : A) => box a
def read : Box Nat -> Nat := fun (b : Box Nat) => elim b as x in Box return Nat { fun (n : Nat) => n }
def answer : Nat := read (box 9)
def Alias : Type 0 := Box Nat
def aliasValue : Alias := box 10

mu Maybe (0 A : Type 0) : Type 0 { none : Maybe A; some : A -> Maybe A }
def empty : Maybe Nat := none
def present : Maybe Nat := some 11

mu Both (0 A : Type 0) (0 B : Type 0) : Type 0 { both : A -> B -> Both A B }
def pairValue : Both Nat (prod ()) := both 12 (tuple ())

-- Later fields may depend on earlier constructor fields and family parameters.
mu DepBox (0 A : Type 0) : Type 1 { depBox : (0 B : Type 0) -> B -> A -> DepBox A }
def dependentValue : DepBox Nat := depBox (prod ()) (tuple ()) 13

mu At (0 x : Nat) : (0 y : Nat) -> Type 0 { at : At x x }
def reflexiveValue : At 14 14 := at
def reflexive : (0 x : Nat) -> At x x := fun (0 x : Nat) => at

def ignore : (0 b : Box Nat) -> Nat := fun (0 b : Box Nat) => 0
def erasedArgument : (0 n : Nat) -> Nat := fun (0 n : Nat) => ignore (box n)

-- A parameterless constructor gives its field types to its arguments.
mu W : Type 0 { w : Box Nat -> W }
def wrapped : W := w (box 15)

mu List (0 A : Type 0) : Type 0 { nil : List A; cons : A -> List A -> List A }
def numbers : List Nat := cons 16 (cons 17 nil)
