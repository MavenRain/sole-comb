axiom Nat : Type 1
def Three : Type 1 := (Lan SColl 3 (Sec SColl 3 [ => Nat;  => Nat;  => Nat]))
def id : (Ran SPi w n Nat Nat) := (Sec SPi w n Nat [n => n])
def plus : (Ran SPi w a Nat (Ran SPi w b Nat Nat)) := (Sec SPi w a Nat [a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))])])
def all : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id))])
def suffix : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w b Nat (APt w $elim) (Out SPi w a Nat (APt w 10) plus)) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id))])
def lambda : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) n => n | (ALeg 1) n => n | (ALeg 2) n => n)])
def partial : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w b Nat (APt w $elim) (Out SPi w a Nat (APt w 1) plus)) | (ALeg 2) $elim => (Out SPi w b Nat (APt w $elim) (Out SPi w a Nat (APt w 1) plus)))])
def local : (Ran SPi w f (Ran SPi w n Nat Nat) (Ran SPi w x Three Nat)) := (Sec SPi w f (Ran SPi w n Nat Nat) [f => (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) f) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) f))])])
def motive : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x as value return Nat with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id))])
def functions : (Ran SPi w x Three (Ran SPi w y Nat Nat)) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))]) | (ALeg 1) a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))]) | (ALeg 2) a => (Sec SPi w b Nat [b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))]))])
def linear : (Ran SPi 1 x Nat Nat) := (Sec SPi 1 x Nat [x => x])
def linearArms : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi 1 x Nat (APt 1 $elim) linear) | (ALeg 1) $elim => (Out SPi 1 x Nat (APt 1 $elim) linear) | (ALeg 2) $elim => (Out SPi 1 x Nat (APt 1 $elim) linear))])
def localLinear : (Ran SPi 1 f (Ran SPi w n Nat Nat) (Ran SPi w x Three Nat)) := (Sec SPi 1 f (Ran SPi w n Nat Nat) [f => (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) f) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) f) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) f))])])
def captured : (Ran SPi w n Nat (Ran SPi w x Three Nat)) := (Sec SPi w n Nat [n => (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) payload => (Out SPi w b Nat (APt w payload) (Out SPi w a Nat (APt w n) natAdd)) | (ALeg 1) payload => (Out SPi w b Nat (APt w payload) (Out SPi w a Nat (APt w n) natAdd)) | (ALeg 2) payload => (Out SPi w b Nat (APt w payload) (Out SPi w a Nat (APt w n) natAdd)))])])
def scrutinee : (Ran SPi w x Three Nat) := (Sec SPi w x Three [x => (Elim SColl 3 x with | (ALeg 0) payload => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id)) | (ALeg 1) payload => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id)) | (ALeg 2) payload => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id)))])
def nested : (Ran SPi w x Three (Ran SPi w y Three Nat)) := (Sec SPi w x Three [x => (Sec SPi w y Three [y => (Elim SColl 3 x with | (ALeg 0) $elim => (Out SPi w b Nat (APt w $elim) (Out SPi w a Nat (APt w (Elim SColl 3 y with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id))) plus)) | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id))])])
def heterogeneous : (Ran SPi w x (Lan SColl 3 (Sec SColl 3 [ => Type 1;  => Nat;  => Nat])) Nat) := (Sec SPi w x (Lan SColl 3 (Sec SColl 3 [ => Type 1;  => Nat;  => Nat])) [x => (Elim SColl 3 x with | (ALeg 0) ty => 0 | (ALeg 1) $elim => (Out SPi w n Nat (APt w $elim) id) | (ALeg 2) $elim => (Out SPi w n Nat (APt w $elim) id))])
def answer : Nat := (Out SPi w x (Lan SColl 3 (Sec SColl 3 [ => Nat;  => Nat;  => Nat])) (APt w (In SColl 3 (ALeg 2) [41])) suffix)
def one : (Ran SPi w x (Lan SColl 1 (Sec SColl 1 [ => Nat])) Nat) := (Sec SPi w x (Lan SColl 1 (Sec SColl 1 [ => Nat])) [x => (Elim SColl 1 x with | (ALeg 0) $elim => (Out SPi w n Nat (APt w $elim) id))])
