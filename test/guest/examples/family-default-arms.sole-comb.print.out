exit 0
--- stdout
CHECK examples/family-default-arms.sole-comb defs=11 ok
def all : (Ran SPi w _ (Lan SMu Shade [] (Sec SColl 0 [])) Nat) := (Sec SPi w s (Lan SMu Shade [] (Sec SColl 0 [])) [s => (Elim SMu Shade [] s as x return Nat with | (ACtor light)  => 7 | (ACtor medium)  => 7 | (ACtor dark)  => 7)])
def suffix : (Ran SPi w _ (Lan SMu Shade [] (Sec SColl 0 [])) Nat) := (Sec SPi w s (Lan SMu Shade [] (Sec SColl 0 [])) [s => (Elim SMu Shade [] s as x return Nat with | (ACtor light)  => 1 | (ACtor medium)  => 2 | (ACtor dark)  => 2)])
def function : (Ran SPi w _ (Lan SMu Shade [] (Sec SColl 0 [])) (Ran SPi w _ Nat Nat)) := (Sec SPi w s (Lan SMu Shade [] (Sec SColl 0 [])) [s => (Elim SMu Shade [] s as x return (Ran SPi w _ Nat Nat) with | (ACtor light)  => (Sec SPi w n Nat [n => n]) | (ACtor medium)  => (Sec SPi w n Nat [n => n]) | (ACtor dark)  => (Sec SPi w n Nat [n => n]))])
def readPair : (Ran SPi w _ (Lan SMu Pair [] (Sec SColl 0 [])) Nat) := (Sec SPi w p (Lan SMu Pair [] (Sec SColl 0 [])) [p => (Elim SMu Pair [] p as x return Nat with | (ACtor pairA) a b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd)) | (ACtor pairB) a b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd)) | (ACtor pairC) a b => (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd)))])
def pairSuffix : (Ran SPi w _ (Lan SMu Pair [] (Sec SColl 0 [])) Nat) := (Sec SPi w p (Lan SMu Pair [] (Sec SColl 0 [])) [p => (Elim SMu Pair [] p as x return Nat with | (ACtor pairA) a b => a | (ACtor pairB) a b => b | (ACtor pairC) a b => b)])
def captured : (Ran SPi w offset Nat (Ran SPi w _ (Lan SMu Pair [] (Sec SColl 0 [])) Nat)) := (Sec SPi w offset Nat [offset => (Sec SPi w p (Lan SMu Pair [] (Sec SColl 0 [])) [p => (Elim SMu Pair [] p as x return Nat with | (ACtor pairA) a b => (Out SPi w b Nat (APt w (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))) (Out SPi w a Nat (APt w offset) natAdd)) | (ACtor pairB) a b => (Out SPi w b Nat (APt w (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))) (Out SPi w a Nat (APt w offset) natAdd)) | (ACtor pairC) a b => (Out SPi w b Nat (APt w (Out SPi w b Nat (APt w b) (Out SPi w a Nat (APt w a) natAdd))) (Out SPi w a Nat (APt w offset) natAdd)))])])
def pairFunction : (Ran SPi w _ (Lan SMu Pair [] (Sec SColl 0 [])) (Ran SPi w _ Nat Nat)) := (Sec SPi w p (Lan SMu Pair [] (Sec SColl 0 [])) [p => (Elim SMu Pair [] p as x return (Ran SPi w _ Nat Nat) with | (ACtor pairA) a b => (Sec SPi w n Nat [n => (Out SPi w b Nat (APt w n) (Out SPi w a Nat (APt w a) natAdd))]) | (ACtor pairB) a b => (Sec SPi w n Nat [n => (Out SPi w b Nat (APt w n) (Out SPi w a Nat (APt w a) natAdd))]) | (ACtor pairC) a b => (Sec SPi w n Nat [n => (Out SPi w b Nat (APt w n) (Out SPi w a Nat (APt w a) natAdd))]))])
def linearRead : (Ran SPi w _ (Lan SMu Linear [] (Sec SColl 0 [])) Nat) := (Sec SPi w p (Lan SMu Linear [] (Sec SColl 0 [])) [p => (Elim SMu Linear [] p as x return Nat with | (ACtor linearA) n => n | (ACtor linearB) n => n)])
def last : (Ran SPi w _ (Lan SMu Pack [] (Sec SColl 0 [])) Nat) := (Sec SPi w p (Lan SMu Pack [] (Sec SColl 0 [])) [p => (Elim SMu Pack [] p as x return Nat with | (ACtor packA) A a n => n | (ACtor packB) A a n => n)])
def copy : (Ran SPi 0 i (Lan SMu N [] (Sec SColl 0 [])) (Ran SPi w _ (Lan SMu V [i] (Sec SColl 0 [])) (Lan SMu V [i] (Sec SColl 0 [])))) := (Sec SPi 0 i (Lan SMu N [] (Sec SColl 0 [])) [i => (Sec SPi w v (Lan SMu V [i] (Sec SColl 0 [])) [v => (Elim SMu V [i] v as x return (Lan SMu V [j] (Sec SColl 0 [])) with | (ACtor vz)  => (In SMu V [(In SMu N [] (ACtor zero) [])] (ACtor vz) []) | (ACtor vs) k a w => (In SMu V [(In SMu N [] (ACtor succ) [k])] (ACtor vs) [k; a; w]))])])
def unbox : (Ran SPi w _ (Lan SMu Box [] (Sec SColl 1 [ => Nat])) Nat) := (Sec SPi w b (Lan SMu Box [] (Sec SColl 1 [ => Nat])) [b => (Elim SMu Box [] b as x return Nat with | (ACtor boxA) n => n | (ACtor boxB) n => n)])
